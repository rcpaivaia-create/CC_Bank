<configuration>
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n"/>

    <appender name="ESQUERDO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/client-esquerdo.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/client-esquerdo.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="DIREITO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/client-direito.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/client-direito.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <logger name="ccbank.cliente.esquerdo" level="INFO" additivity="false">
        <appender-ref ref="ESQUERDO"/>
    </logger>
    <logger name="ccbank.cliente.direito" level="INFO" additivity="false">
        <appender-ref ref="DIREITO"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
