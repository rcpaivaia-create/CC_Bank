<configuration>
    <!-- ccbank.lado é definido pelo InterceptadorMain (esquerdo ou direito). -->
    <property name="ARQUIVO_LOG" value="interceptor-${ccbank.lado:-esquerdo}"/>
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n"/>

    <appender name="ARQUIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${ARQUIVO_LOG}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${ARQUIVO_LOG}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="ARQUIVO"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
