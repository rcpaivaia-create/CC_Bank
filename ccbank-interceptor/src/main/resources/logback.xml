<configuration>
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n"/>

    <appender name="ESQUERDO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/interceptor-esquerdo.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/interceptor-esquerdo.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="DIREITO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/interceptor-direito.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/interceptor-direito.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <!-- Um logger por lado; no headless cada processo usa um, na tela um processo usa os dois. -->
    <logger name="ccbank.interceptador.esquerdo" level="INFO" additivity="false">
        <appender-ref ref="ESQUERDO"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="ccbank.interceptador.direito" level="INFO" additivity="false">
        <appender-ref ref="DIREITO"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
